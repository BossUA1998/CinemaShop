# PostgreSQL
POSTGRES_DB=<db_name>
POSTGRES_DB_PORT=<db_port>
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
POSTGRES_HOST=postgres_cinema_shop

# pgAdmin
PGADMIN_DEFAULT_EMAIL=<email|admin@admin.com>
PGADMIN_DEFAULT_PASSWORD=<password>

# JWT keys
SECRET_KEY_ACCESS=<key&32chars>
SECRET_KEY_REFRESH=<key&32chars>
JWT_SIGNING_ALGORITHM=<algorithm|HS256>

# Email notifications
# If the password contains spaces, replace them with the symbol |
SMTP_SERVER=<smtp_server>
SMTP_PORT=<int>
SMTP_USER=<email>
SMTP_PASSWORD=<smtp_password>

# Celery worker
CELERY_BROKER_URL=redis://redis:6379
CELERY_RESULT_BACKEND=redis://redis:6379
