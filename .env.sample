# PostgreSQL
POSTGRES_DB=<db_name>
POSTGRES_DB_PORT=<db_port>
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
POSTGRES_HOST=postgres_cinema_shop

# pgAdmin
PGADMIN_DEFAULT_EMAIL=<email|admin@admin.com>
PGADMIN_DEFAULT_PASSWORD=<password>

# JWT keys
SECRET_KEY_ACCESS=<key&32chars>
SECRET_KEY_REFRESH=<key&32chars>
JWT_SIGNING_ALGORITHM=<algorithm|HS256>
